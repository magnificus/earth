{
  "name": "babylon-earth",
  "version": "1.0.0",
  "description": "Babylon.js project with TypeScript and Webpack",
  "main": "src/index.ts",
  "scripts": {
    "check:duplication": "node scripts/check-duplication.mjs",
    "test:oslo-walk": "node tests/drive-render-performance.mjs --oslo-walk",
    "test:vista": "node tests/drive-render-performance.mjs --vista",
    "test:loading": "node tests/drive-render-performance.mjs --loading",
    "test:promotion": "node tests/drive-render-performance.mjs --promotion",
    "benchmark:nyc-roads": "node --import ./tests/register-typescript.mjs scripts/benchmark-nyc-roads.mjs",
    "test:memory": "node tests/drive-render-performance.mjs --memory-soak",
    "dev": "webpack serve --mode development",
    "game:dev": "yarn node --experimental-sqlite server/local-game-server.mjs",
    "build": "webpack --mode production",
    "build:stars": "node scripts/build-star-catalog.mjs",
    "layouts:examples": "node scripts/render-layout-examples.mjs",
    "layouts:captured": "node --import ./tests/register-typescript.mjs scripts/render-captured-building-layouts.mjs",
    "benchmark:buildings": "node --import ./tests/register-typescript.mjs scripts/benchmark-building-loading.mjs",
    "site-plan:example": "node --import ./tests/register-typescript.mjs scripts/render-road-building-plan-example.mjs",
    "tiles:debug": "node --import ./tests/register-typescript.mjs scripts/render-tile-generation.mjs",
    "test": "node --import ./tests/register-typescript.mjs --test --test-concurrency=4 tests/*.test.mjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "clean": "rimraf dist"
  },
  "keywords": [
    "babylonjs",
    "typescript",
    "3d",
    "webgl"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^20.10.0",
    "@types/suncalc": "^1.9.2",
    "html-webpack-plugin": "^5.6.0",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/materials": "^7.0.0",
    "@mapbox/vector-tile": "^3.0.0",
    "astronomy-engine": "^2.1.19",
    "earcut": "^3.2.3",
    "pbf": "^5.1.2",
    "polygon-clipping": "^0.15.7",
    "suncalc": "^2.0.1",
    "ws": "^8.21.3"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
